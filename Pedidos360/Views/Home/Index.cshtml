@model DashboardViewModel
@{
    ViewData["Title"] = "Panel Principal";
}

<h1 class="page-title">Panel Principal</h1>
<p class="page-subtitle">Bienvenidos a Pedidos 360</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <i class="bi bi-box-seam"></i>
            <div class="stat-value">@Model.TotalProductos</div>
            <div class="stat-label">Productos</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <i class="bi bi-people"></i>
            <div class="stat-value">@Model.TotalClientes</div>
            <div class="stat-label">Clientes</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <i class="bi bi-cart3"></i>
            <div class="stat-value">@Model.TotalPedidos</div>
            <div class="stat-label">Pedidos</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card">
            <i class="bi bi-house-door"></i>
            <div class="stat-value">@Model.StockTotal.ToString("N0")</div>
            <div class="stat-label">Stock total</div>
        </div>
    </div>
</div>

<div class="panel mb-4">
    <h2 class="panel-title">Accesos rápidos</h2>
    <a asp-controller="Productos" asp-action="Create" class="btn btn-primary w-100 mb-2">+ Nuevo Producto</a>
    <a asp-controller="Clientes" asp-action="Create" class="btn btn-outline-secondary w-100">+ Nuevo Cliente</a>
</div>

<div class="panel">
    <h2 class="panel-title">Productos con bajo Stock</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr><th>Imagen</th><th>Nombre</th><th>Categoría</th><th>Stock</th><th>Estado</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.BajoStock)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.ImagenUrl))
                            {
                                <img src="@p.ImagenUrl" alt="@p.Nombre" class="thumb" />
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@p.Nombre</td>
                        <td>@p.Categoria</td>
                        <td class="@(p.Stock == 0 ? "text-danger fw-semibold" : "")">@p.Stock</td>
                        <td>
                            <span class="@(p.Activo ? "estado-activo" : "estado-inactivo")">
                                @(p.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.BajoStock.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">No hay productos con bajo stock.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>