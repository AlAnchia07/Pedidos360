
@model IEnumerable<Pedidos360.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Clientes</h1>
        <a asp-action="Create" class="btn btn-primary">
            Nuevo cliente
        </a>
    </div>
    
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="buscar"
               value="@ViewData["BuscarActual"]"
               class="form-control"
               placeholder="Buscar por nombre o cédula..." />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Limpiar
        </a>
    </div>
</form>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Correo electrónico</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Cedula</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Direccion</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@cliente.Id"
                               class="btn btn-info btn-sm">Detalles</a>

                            <a asp-action="Edit" asp-route-id="@cliente.Id"
                               class="btn btn-warning btn-sm">Editar</a>

                            <a asp-action="Delete" asp-route-id="@cliente.Id"
                               class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No hay clientes registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
