
@model Cliente
@{ ViewData["Title"] = "Detalle del Cliente"; }

<div class="form-page">
    <h1 class="page-title">Detalle del Cliente</h1>
    <div class="breadcrumb-mini">
        <a asp-controller="Home" asp-action="Index">Inicio</a> /
        <a asp-action="Index">Clientes</a> / Detalle del Cliente
    </div>

    <div class="panel">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2 class="panel-title mb-0">@Model.Nombre</h2>
                <p class="text-muted small mb-3">Información del cliente</p>
            </div>
            <span class="badge-registrado">Registrado</span>
        </div>
        <hr class="mt-0 mb-4" />

        <div class="row g-4">
            <div class="col-md-6">
                <div class="dato-label">Nombre completo o razón social</div>
                <div class="dato-valor">@Model.Nombre</div>
            </div>
            <div class="col-md-6">
                <div class="dato-label">Cédula física o jurídica</div>
                <div class="dato-valor">@Model.Cedula</div>
            </div>
            <div class="col-md-6">
                <div class="dato-label">Correo electrónico</div>
                <div class="dato-valor">
                    <a href="mailto:@Model.Correo">@Model.Correo</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="dato-label">Teléfono</div>
                <div class="dato-valor">@Model.Telefono</div>
            </div>
            <div class="col-12">
                <div class="dato-label">Dirección</div>
                <div class="dato-valor">@Model.Direccion</div>
            </div>
        </div>

        <div class="form-actions mt-4">
            <a asp-action="Index" class="btn btn-light border btn-sm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="bi bi-pencil-square"></i> Editar Cliente
                </a>
            }
            
        </div>
    </div>
</div>