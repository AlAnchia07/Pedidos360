@model IEnumerable<Pedidos360.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<h1 class="page-title">Categorías</h1>
<p class="page-subtitle">Administra las categorías de productos.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<div class="mb-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Nueva categoría</a>
    }
    <a asp-controller="Productos" asp-action="Index" class="btn btn-secondary">Volver a productos</a>
</div>

<div class="panel table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Productos asociados</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var categoria in Model)
        {
            <tr>
                <td>@categoria.Nombre</td>
                <td>@categoria.Productos.Count</td>
                <td>
                        <a asp-action="Details" asp-route-id="@categoria.Id" class="btn btn-outline-secondary btn-sm btn-icon" title="Consultar">
                            <i class="bi bi-eye"></i>
                        </a>
                    
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@categoria.Id" class="btn btn-primary btn-sm btn-icon" title="Editar"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@categoria.Id" class="btn btn-danger btn-sm btn-icon" title="Eliminar"><i class="bi bi-trash"></i></a>
                        }
                        
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-center text-muted">No hay categorías registradas.</p>
    }
</div>
