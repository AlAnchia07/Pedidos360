@model Pedidos360.Models.Categoria
@{
    ViewData["Title"] = "Detalle categoría";
}

<h1 class="page-title">Detalle de categoría</h1>

<div class="panel p-4">
    <h4>@Model.Nombre</h4>
    <p>Productos asociados: <strong>@Model.Productos.Count</strong></p>

    @if (Model.Productos.Any())
    {
        <ul>
        @foreach (var producto in Model.Productos)
        {
            <li>
                <a asp-controller="Productos" asp-action="Details" asp-route-id="@producto.Id">
                    @producto.Nombre
                </a>
            </li>
        }
        </ul>
    }
    else
    {
        <p>Esta categoría todavía no tiene productos.</p>
    }

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
