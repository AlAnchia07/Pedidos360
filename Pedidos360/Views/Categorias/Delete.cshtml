@model Pedidos360.Models.Categoria
@{
    ViewData["Title"] = "Eliminar categoría";
}

<h1 class="page-title">Eliminar categoría</h1>

<div class="panel p-4">
    <p>¿Deseas eliminar la categoría <strong>@Model.Nombre</strong>?</p>

    @if (Model.Productos.Any())
    {
        <div class="alert alert-warning">
            Esta categoría tiene @Model.Productos.Count producto(s) asociado(s).
            No se puede eliminar mientras tenga productos relacionados.
        </div>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    }
    else
    {
        <div class="alert alert-danger">Esta acción no se puede deshacer.</div>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    }
</div>
