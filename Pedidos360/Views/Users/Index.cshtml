@model IEnumerable<Pedidos360.Models.ViewModels.UserListItemViewModel>
@using Pedidos360.Security
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h1>Usuarios</h1>
    <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
</div>

@if (TempData["Mensaje"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>
                <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@user.Id" />
                    <select name="role" class="form-select form-select-sm" aria-label="Rol de @user.Email">
                        @foreach (var role in RoleNames.All)
                        {
                            <option value="@role" selected="@(user.Role == role)">@role</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm btn-icon" title="Guardar"><i class="bi bi-floppy"></i></button>
                </form>
            </td>
            <td>@(user.IsActive ? "Activo" : "Inactivo")</td>
            <td>
                <form asp-action="ToggleActive" method="post">
                    <input type="hidden" name="id" value="@user.Id" />
                        <button type="submit" class="btn btn-sm btn-icon @(user.IsActive ? "btn-danger" : "btn-success")" title="@(user.IsActive ? "Desactivar" : "Activar")">
                            <i class=" bi @(user.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
