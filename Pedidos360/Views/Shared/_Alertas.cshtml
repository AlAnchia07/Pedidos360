<div id="alertas-js">
@if (TempData["Exito"] != null)
{
    <div class="alerta-p360 alerta-ok" role="alert">
        <i class="bi bi-check-circle alerta-icono"></i>
        <div class="alerta-texto">
            <div class="alerta-titulo">@TempData["Exito"]</div>
            @if (TempData["ExitoDetalle"] != null) { <div class="alerta-detalle">@TempData["ExitoDetalle"]</div> }
        </div>
        <button type="button" class="alerta-cerrar" aria-label="Cerrar" onclick="this.parentElement.remove()"><i class="bi bi-x-lg"></i></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alerta-p360 alerta-error" role="alert">
        <i class="bi bi-x-circle alerta-icono"></i>
        <div class="alerta-texto">
            <div class="alerta-titulo">@TempData["Error"]</div>
        </div>
        <button type="button" class="alerta-cerrar" aria-label="Cerrar" onclick="this.parentElement.remove()"><i class="bi bi-x-lg"></i></button>
    </div>
}
</div>