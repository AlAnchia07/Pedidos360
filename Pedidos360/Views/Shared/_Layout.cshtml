@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => ctrl == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pedidos360</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">

        <aside id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-title"><i class="bi bi-box-seam"></i> Pedidos360</div>
                <small>Inventario y pedidos B2B</small>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-link-item @Active("Home")"><i class="bi bi-grid"></i> Inicio</a>
                <a asp-controller="Productos" asp-action="Index" class="nav-link-item @Active("Productos")"><i class="bi bi-box-seam"></i> Productos</a>
                <a asp-controller="Clientes" asp-action="Index" class="nav-link-item @Active("Clientes")"><i class="bi bi-people"></i> Clientes</a>
                <a asp-controller="Pedidos" asp-action="Index" class="nav-link-item @Active("Pedidos")"><i class="bi bi-cart3"></i> Pedidos</a>
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="nav-link-item w-100 border-0 bg-transparent">
                            <i class="bi bi-box-arrow-left"></i> Cerrar Sesión
                        </button>
                    </form>
                }
            </div>
        </aside>

        <div class="main">
            <header class="topbar">
                <button class="btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Menú">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Buscar en el Sistema" />
                </div>
                <div class="topbar-user">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="d-none d-md-inline me-2">@User.Identity.Name</span>
                    }
                    <i class="bi bi-person-circle"></i>
                </div>
            </header>

            <main class="content">
                <partial name="_Alertas" />
                <partial name="_ConfirmarEliminar" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>