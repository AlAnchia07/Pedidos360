@model EditarStockDto

<h1 class="page-title">Editar stock</h1>

<div class="panel p-4">
    <form asp-action="EditStock" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Producto</label>
            <input asp-for="Nombre" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Stock actual</label>
            <input asp-for="StockActual" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="NuevoStock" class="form-label">
                Nuevo stock
            </label>
            <input asp-for="NuevoStock"
                   type="number"
                   min="0"
                   class="form-control" />
            <span asp-validation-for="NuevoStock"
                  class="text-danger"></span>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>
        </div>

    </form>
</div>
