@model Pedidos360.Models.Producto
@{
    ViewData["Title"] = "Crear Producto";
}

<h1 class="page-title">Crear producto</h1>
<p class="page-subtitle">Registra un nuevo producto en el catálogo.</p>

<div class="panel p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label">Categoría</label>
            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                <option value="">Seleccione una categoría</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Precio" class="form-label">Precio</label>
            <input asp-for="Precio" type="number" min="0.01" step="0.01" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ImpuestoPorc" class="form-label">Impuesto (%)</label>
            <input asp-for="ImpuestoPorc" type="number" min="0" max="100" step="0.01" class="form-control" />
            <span asp-validation-for="ImpuestoPorc" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Stock" class="form-label">Stock actual</label>
            <input asp-for="Stock" type="number" min="0" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
            <input asp-for="StockMinimo" type="number" min="0" class="form-control" />
            <span asp-validation-for="StockMinimo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Imagen del producto</label>
            <input type="file" name="imagenFile" class="form-control"
                   accept=".jpg,.jpeg,.png,.webp" required />
            <small class="text-muted">JPG, JPEG, PNG o WEBP. Máximo 5 MB.</small>
            <span class="text-danger">@Html.ValidationMessage("imagenFile")</span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">Producto activo</label>
        </div>

        <button type="submit" class="btn btn-primary">Guardar producto</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
