
@model Pedidos360.Models.Pedido

@{
    ViewData["Title"] = "Detalle del pedido";
}

<h1>Detalle del pedido #@Model.Id</h1>

<hr />

<div class="card mb-4">
    <div class="card-header">
        <h5>Información general</h5>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <strong>Cliente:</strong>
                <p>@Model.Cliente?.Nombre</p>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Fecha:</strong>
                <p>@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Usuario:</strong>
                <p>@(Model.Usuario?.UserName ?? "No disponible")</p>
            </div>

            <div class="col-md-6 mb-3">
                <strong>Estado:</strong>
                <p>@Model.Estado</p>
            </div>
        </div>
    </div>
</div>

<h4>Productos del pedido</h4>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio unitario</th>
                <th>Cantidad</th>
                <th>Descuento</th>
                <th>Impuesto</th>
                <th>Total de línea</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var detalle in Model.Detalles)
            {
                <tr>
                    <td>@detalle.Producto?.Nombre</td>
                    <td>@detalle.PrecioUnit.ToString("C2")</td>
                    <td>@detalle.Cantidad</td>
                    <td>@detalle.Descuento.ToString("C2")</td>
                    <td>@detalle.ImpuestoPorc%</td>
                    <td>@detalle.TotalLinea.ToString("C2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row justify-content-end">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <p class="d-flex justify-content-between">
                    <strong>Subtotal:</strong>
                    <span>@Model.Subtotal.ToString("C2")</span>
                </p>

                <p class="d-flex justify-content-between">
                    <strong>Impuestos:</strong>
                    <span>@Model.Impuestos.ToString("C2")</span>
                </p>

                <hr />

                <h4 class="d-flex justify-content-between">
                    <strong>Total:</strong>
                    <span>@Model.Total.ToString("C2")</span>
                </h4>
            </div>
        </div>
    </div>
</div>

<br />

<a asp-action="Index" class="btn btn-secondary">
    Volver a pedidos
</a>
