
@model IEnumerable<Pedidos360.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>
    
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="buscar"
               value="@ViewBag.Buscar"
               class="form-control"
               placeholder="Buscar por número de pedido o cliente..." />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Limpiar
        </a>
    </div>
</form>

@if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Registrar nuevo pedido
        </a>
    </p>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Número</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Subtotal</th>
            <th>Impuestos</th>
            <th>Total</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pedido in Model)
        {
            <tr>
                <td>@pedido.Id</td>
                <td>@pedido.Cliente?.Nombre</td>
                <td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@pedido.Subtotal.ToString("C2")</td>
                <td>@pedido.Impuestos.ToString("C2")</td>
                <td>@pedido.Total.ToString("C2")</td>
                <td>@pedido.Estado</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pedido.Id" class="btn btn-outline-secondary btn-sm btn-icon" title="Ver Detalle">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
